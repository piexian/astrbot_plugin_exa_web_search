{
  "exa_api_keys": {
    "type": "list",
    "description": "Exa API Key 列表",
    "hint": "支持多个 Key 进行轮询，前往 https://dashboard.exa.ai/api-keys 获取",
    "default": []
  },
  "exa_base_url": {
    "type": "string",
    "description": "Exa API Base URL",
    "hint": "默认为官方，可改为代理地址",
    "default": "https://api.exa.ai"
  },
  "timeout_seconds": {
    "type": "int",
    "description": "请求超时时间（秒）",
    "hint": "控制每次 API 请求的最大等待时间；deep 至少 60 秒，deep-reasoning 至少 90 秒",
    "default": 30,
    "slider": {
      "min": 30,
      "max": 120,
      "step": 5
    }
  },
  "max_results": {
    "type": "int",
    "description": "搜索返回最大条数",
    "hint": "控制搜索结果的最大返回数量（1-100）",
    "default": 10,
    "slider": {
      "min": 1,
      "max": 100,
      "step": 1
    }
  },
  "default_search_type": {
    "type": "string",
    "description": "默认搜索类型",
    "options": [
      "instant",
      "fast",
      "auto",
      "deep-lite",
      "deep",
      "deep-reasoning"
    ],
    "default": "auto"
  },
  "moderation": {
    "type": "bool",
    "description": "启用 Exa 内容审核",
    "hint": "开启后由 Exa 过滤不安全内容；默认关闭",
    "default": false
  },
  "show_sources": {
    "type": "bool",
    "description": "是否在结果中显示来源 URL",
    "hint": "启用后将在搜索结果中显示来源链接",
    "default": true
  },
  "max_sources": {
    "type": "int",
    "description": "最大显示来源数量",
    "hint": "控制返回的来源链接数量，0 表示不限制",
    "default": 5,
    "slider": {
      "min": 0,
      "max": 20,
      "step": 1
    }
  },
  "max_retries": {
    "type": "int",
    "description": "最大重试次数",
    "hint": "请求失败时的最大重试次数",
    "default": 3,
    "slider": {
      "min": 0,
      "max": 10,
      "step": 1
    }
  },
  "retry_delay": {
    "type": "float",
    "description": "重试间隔时间（秒）",
    "hint": "基础重试间隔，使用指数退避，429 时优先使用 Retry-After 头",
    "default": 1.0,
    "slider": {
      "min": 0.5,
      "max": 10,
      "step": 0.5
    }
  },
  "agent_max_concurrent": {
    "type": "int",
    "description": "Agent 最大并发任务数",
    "default": 2,
    "slider": {"min": 1, "max": 20, "step": 1}
  },
  "agent_poll_interval_seconds": {
    "type": "float",
    "description": "Agent 状态轮询间隔（秒）",
    "default": 5.0,
    "slider": {"min": 1, "max": 60, "step": 1}
  },
  "agent_status_retry_limit": {
    "type": "int",
    "description": "Agent 状态查询重试阈值",
    "default": 5,
    "slider": {"min": 1, "max": 50, "step": 1}
  },
  "agent_effort": {
    "type": "string",
    "description": "Agent 研究强度",
    "options": ["minimal", "low", "medium", "high", "xhigh", "auto", "max"],
    "default": "auto"
  },
  "agent_budget_max_dollars": {
    "type": "float",
    "description": "单个 Agent 任务预算上限（美元）",
    "default": 5.0,
    "slider": {"min": 0.5, "max": 100, "step": 0.5}
  },
  "task_archive_max_size_mb": {
    "type": "int",
    "description": "任务归档容量上限（MB）",
    "hint": "包含 SQLite 主库、WAL 和 SHM 文件；达到 80% 告警，超过 100% 自动清理终态任务",
    "default": 100,
    "slider": {"min": 10, "max": 2000, "step": 10}
  },
  "proxy": {
    "type": "string",
    "description": "HTTP 代理地址",
    "hint": "例如: http://127.0.0.1:7890，留空则不使用代理",
    "default": ""
  }
}
